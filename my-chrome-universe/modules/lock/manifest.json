{
  "manifest_version": 3,
  "name": "Browser Lock - Kunci Browser dengan Password",
  "short_name": "Browser Lock",
  "version": "1.0.0",
  "description": "Kunci browser dengan password. Meminta password setiap kali browser dibuka, saat idle, atau kapan saja lewat tombol Kunci.",
  "permissions": [
    "storage",
    "tabs",
    "idle"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser Lock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/lock16.png",
      "32": "icons/lock32.png",
      "48": "icons/lock48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/lock16.png",
    "32": "icons/lock32.png",
    "48": "icons/lock48.png",
    "128": "icons/lock128.png"
  },
  "commands": {
    "lock-browser": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Kunci browser sekarang"
    }
  }
}
