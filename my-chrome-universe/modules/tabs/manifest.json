{
  "manifest_version": 3,
  "name": "Tab Manager - Simpan Sesi & Koleksi Tab",
  "short_name": "Tab Manager",
  "version": "1.0.0",
  "description": "Simpan semua tab dalam satu klik, atur ke dalam koleksi dan ruang, lalu buka lagi kapan saja. Semua data tersimpan lokal.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "tabs", "tabGroups", "contextMenus", "favicon"],
  "optional_permissions": ["bookmarks"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Tab Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "omnibox": {
    "keyword": "tm"
  },
  "commands": {
    "save-session": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Simpan semua tab di jendela ini sebagai koleksi"
    },
    "save-tab": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Simpan tab aktif ke koleksi \"Disimpan\""
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
