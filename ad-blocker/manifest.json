{
  "manifest_version": 3,
  "name": "Ad Blocker - Pemblokir Iklan",
  "short_name": "Ad Blocker",
  "version": "1.0.0",
  "description": "Blokir iklan, pelacak, dan elemen mengganggu memakai filter list EasyList dan ABPindo. Tanpa iklan yang diizinkan, tanpa telemetri.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "webNavigation",
    "webRequest",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ad Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "indonesia",
        "enabled": false,
        "path": "rules/indonesia.json"
      },
      {
        "id": "security",
        "enabled": true,
        "path": "rules/security.json"
      },
      {
        "id": "privacy",
        "enabled": false,
        "path": "rules/privacy.json"
      },
      {
        "id": "annoyances",
        "enabled": false,
        "path": "rules/annoyances.json"
      }
    ]
  }
}
